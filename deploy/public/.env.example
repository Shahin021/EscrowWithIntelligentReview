# Copy to .env on the host. Never commit .env, keys, the database or SMTP credentials.
ESCROW_DOMAIN=escrow.example.com

# Start tracking-only; turn sending on only after the operator key is mounted
# (compose.override.yaml) and no other sender uses the same key.
AUTOMATION_SENDING=off

# The operator key path is set by compose.override.yaml (see compose.override.example.yaml).
OPERATOR_KEY_FILE=

# file = write .eml files to the volume (no delivery). smtp = real delivery.
MAIL_TRANSPORT=file
MAIL_FROM=Escrow <no-reply@escrow.example.com>
SMTP_URL=
# Example for Resend (the password is an API key; keep it only in this host file):
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Escrow <no-reply@your-verified-domain.example>
# SMTP_URL=smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
